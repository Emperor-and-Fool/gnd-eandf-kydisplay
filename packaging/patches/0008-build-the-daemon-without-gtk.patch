From: Mirdispo contributors
Subject: Build the daemon and the stream helper without GTK

Both linked GTK 4, libadwaita and libportal-gtk4 without drawing anything.
The only GTK call they made was gtk_string_list_new(), which fills the
missing-video-codec and missing-audio-codec properties. Only the graphical
app reads those, to offer installing a codec. Pulling a toolkit and its
theme library into a background service for that makes it heavier to
install, and much heavier to ship in a sandbox whose runtime has no GTK.

The lists are now built by nd_codec_list_new(). In the app it still returns
a GtkStringList. In the daemon and the stream helper, which are compiled
with ND_NO_GTK, it returns NULL. GTK, libadwaita and libportal-gtk4 are only
required when the app is built. The stream helper uses plain libportal,
since it never passes a parent window to the portal.

The icon cache and desktop database are only updated when the app is
built, since nothing else installs icons or a desktop file. On a system
without that cache the update failed and stopped the install.

The app builds and behaves as before.

diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -39,7 +39,10 @@
   subdir('po')
 endif
 
-gnome.post_install(
-  gtk_update_icon_cache: true,
-  update_desktop_database: true,
-)
+# Only the app installs icons and a desktop file to update caches for.
+if build_app
+  gnome.post_install(
+    gtk_update_icon_cache: true,
+    update_desktop_database: true,
+  )
+endif
diff -ruN a/src/meson.build b/src/meson.build
--- a/src/meson.build
+++ b/src/meson.build
@@ -49,13 +49,22 @@
   dependency('gstreamer-pbutils-1.0', version: '>= 1.14'),
   dependency('gstreamer-plugins-base-1.0'),
   dependency('gstreamer-rtsp-server-1.0'),
-  dependency('gtk4', version: '>= 4.13.0'),
   dependency('libnm', version: '>= 1.15'),
-  dependency('libportal-gtk4', version: '>= 0.7'),
+  dependency('libportal', version: '>= 0.7'),
   dependency('libpulse-mainloop-glib'),
-  dependency('libadwaita-1', version: '>= 1.6.0'),
 ]
 
+# Only the graphical app uses GTK. The daemon and the stream helper are built
+# without it, so they can run where GTK is not installed.
+gnome_nd_gtk_deps = []
+if build_app
+  gnome_nd_gtk_deps = [
+    dependency('gtk4', version: '>= 4.13.0'),
+    dependency('libportal-gtk4', version: '>= 0.7'),
+    dependency('libadwaita-1', version: '>= 1.6.0'),
+  ]
+endif
+
 if get_option('systemd_resolved')
   gnome_nd_common_deps += [
     dependency('libsystemd', version: '>=259')
@@ -127,16 +136,19 @@
 
 gnome_nd_app_deps = []
 gnome_nd_app_deps += gnome_nd_common_deps
+gnome_nd_app_deps += gnome_nd_gtk_deps
 
 if build_daemon
   executable('gnome-network-displays-daemon',
     gnome_nd_daemon_sources,
+    c_args: ['-DND_NO_GTK'],
     dependencies: gnome_nd_daemon_deps,
     install: true,
     link_with: [wfd_server, cc_cast_channel],
   )
   executable('gnome-network-displays-stream',
     gnome_nd_stream_sources,
+    c_args: ['-DND_NO_GTK'],
     dependencies: gnome_nd_stream_deps,
     install: true,
     link_with: [wfd_server, cc_cast_channel],
