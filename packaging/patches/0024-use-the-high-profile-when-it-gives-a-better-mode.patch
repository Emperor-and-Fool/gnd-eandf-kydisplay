+static const gchar *
+wfd_profile_name (WfdH264ProfileFlags profile)
+{
+  return (profile & WFD_H264_PROFILE_BASE) ? "constrained baseline" : "constrained high";
+}
+
+static const gchar *
+wfd_level_name (guint8 level)
+{
+  switch (level)
+    {
+    case 1: return "3.1";
+    case 1 << 1: return "3.2";
+    case 1 << 2: return "4";
+    case 1 << 3: return "4.1";
+    case 1 << 4: return "4.2";
+    case 1 << 5: return "5";
+    case 1 << 6: return "5.1";
+    case 1 << 7: return "5.2";
+    default: return "unknown";
+    }
+}
+
+/* The mode that would be used from one of the receiver's codec entries.
+ *
+ * Its CEA modes come first. A receiver advertises three tables: CEA holds
+ * the timings consumer televisions are built to display, VESA the computer
+ * monitor ones, HH the handheld ones. Taking the largest mode across all
+ * three sent a television 1920x1200, a monitor shape it accepted but had to
+ * resynchronise for, which showed as the picture flashing. A receiver that
+ * offers CEA modes is saying which timings it is made for.
+ */
+static WfdResolution *
+wfd_client_best_mode (WfdVideoCodec *codec, gint width, gint height)
+{
+  g_autoptr(GList) preferred = wfd_video_codec_get_resolutions_cea (codec);
+  g_autoptr(GList) all = NULL;
+  WfdResolution *best = wfd_client_pick_resolution (preferred, width, height);
+
+  if (!best)
+    {
+      all = wfd_video_codec_get_resolutions (codec);
+      best = wfd_client_pick_resolution (all, width, height);
+    }
+
+  return best;
+}
+
+/* Whether mode @a shows the source better than mode @b: more of it, or the
+ * same at a higher refresh rate. */
+static gboolean
+wfd_client_mode_better (WfdResolution *a, WfdResolution *b, gint width, gint height)
+{
+  if (!a)
+    return FALSE;
+  if (!b)
+    return TRUE;
+
+  if (width > 0 && height > 0)
+    {
+      gdouble shown_a = displayed_scale (a, width, height);
+      gdouble shown_b = displayed_scale (b, width, height);
+
+      if (ABS (shown_a - shown_b) > 0.01)
+        return shown_a > shown_b;
+    }
+
+  return compare_resolutions (a, b) > 0;
+}
+
+/**
+ * wfd_client_choose_codec:
+ * @codecs: (element-type WfdVideoCodec): the codec entries a receiver offers
+ * @high_possible: whether the encoder can produce the constrained high profile
+ * @width: width of what is being captured, or 0 if unknown
+ * @height: height of what is being captured, or 0 if unknown
+ * @mode: (out) (transfer none): the mode to use from the chosen entry
+ *
+ * A receiver lists what it decodes per H.264 profile, and a television can
+ * take 1080p at 60 Hz in the constrained high profile while its constrained
+ * baseline entry stops at 30 Hz. The baseline entry is used unless another
+ * entry the encoder can produce shows the source better. Between entries
+ * showing it equally well, the baseline one is kept, then the higher level.
+ *
+ * Returns: (transfer none) (nullable): the chosen entry
+ */
+WfdVideoCodec *
+wfd_client_choose_codec (GPtrArray      *codecs,
+                         gboolean        high_possible,
+                         gint            width,
+                         gint            height,
+                         WfdResolution **mode)
+{
+  WfdVideoCodec *codec = NULL;
+  WfdResolution *codec_mode = NULL;
+
+  /* Entries the encoder cannot produce are a last resort. */
+  for (gint pass = 0; pass < 2 && !codec; pass++)
+    {
+      for (guint i = 0; i < codecs->len; i++)
+        {
+          WfdVideoCodec *item = g_ptr_array_index (codecs, i);
+          gboolean item_base = (item->profile & WFD_H264_PROFILE_BASE) != 0;
+          WfdResolution *item_mode;
+
+          if (pass == 0 && !item_base && !high_possible)
+            continue;
+
+          item_mode = wfd_client_best_mode (item, width, height);
+
+          if (!codec || wfd_client_mode_better (item_mode, codec_mode, width, height))
+            {
+              codec = item;
+              codec_mode = item_mode;
+            }
+          else if (!wfd_client_mode_better (codec_mode, item_mode, width, height))
+            {
+              gboolean codec_base = (codec->profile & WFD_H264_PROFILE_BASE) != 0;
+
+              if ((item_base && !codec_base) ||
+                  (item_base == codec_base && item->level > codec->level))
+                {
+                  codec = item;
+                  codec_mode = item_mode;
+                }
+            }
+        }
+    }
+
+  if (mode)
+    *mode = codec_mode;
+
+  return codec;
+}
+
+/* Whether the encoder that will be used can produce the constrained high
+ * profile. x264 is used whenever it is installed (patch 0001), and the VA
+ * encoders can too; only OpenH264 is limited to baseline. */
+static gboolean
+wfd_client_high_profile_possible (void)
+{
+  const gchar *encoders[] = { "x264enc", "vah264enc", "vaapih264enc" };
+
+  for (guint i = 0; i < G_N_ELEMENTS (encoders); i++)
+    {
+      g_autoptr(GstElementFactory) factory = gst_element_factory_find (encoders[i]);
+
+      if (factory)
+        return TRUE;
+    }
+
+  return FALSE;
+}
