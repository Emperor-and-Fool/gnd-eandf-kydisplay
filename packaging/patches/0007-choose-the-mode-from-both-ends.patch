+static gint source_width = 0;
+static gint source_height = 0;
+
+/**
+ * wfd_client_set_source_size:
+ * @width: width of what is being captured, or 0 if unknown
+ * @height: height of what is being captured, or 0 if unknown
+ *
+ * Records the size of the screen or window being shared, so that the mode
+ * sent to the receiver can be chosen against both ends rather than the
+ * receiver alone.
+ *
+ * This is process-wide because each cast runs in a helper process of its
+ * own: there is exactly one capture per process for its whole lifetime.
+ */
+void
+wfd_client_set_source_size (gint width, gint height)
+{
+  source_width = width;
+  source_height = height;
+}
+
+/* How much of the captured screen a mode actually shows.
+ *
+ * The picture is fitted into the mode without distorting it, so the scale is
+ * limited by whichever axis runs out first. A mode whose shape differs from
+ * the source wastes the difference on black bars, and this accounts for that
+ * without having to reason about shape separately: 1920x1080 shows more of a
+ * 16:10 screen than 1680x1050 does, even though 1680x1050 is the same shape,
+ * and far more than 720x480, which is closer in shape still.
+ */
+static gdouble
+displayed_scale (WfdResolution *mode, gint width, gint height)
+{
+  gdouble horizontal = (gdouble) mode->width / width;
+  gdouble vertical = (gdouble) mode->height / height;
+
+  return MIN (horizontal, vertical);
+}
+
+WfdResolution *
+wfd_client_pick_resolution (GList *resolutions, gint width, gint height)
+{
+  WfdResolution *best = NULL;
+  gboolean constrain = width > 0 && height > 0;
+
+  for (gint pass = 0; pass < 2; pass++)
+    {
+      for (GList *item = resolutions; item; item = item->next)
+        {
+          WfdResolution *candidate = (WfdResolution *) item->data;
+
+          if (candidate->interlaced)
+            continue;
+
+          if (constrain && pass == 0 &&
+              (candidate->width > width || candidate->height > height))
+            continue;
+
+          if (!best)
+            {
+              best = candidate;
+              continue;
+            }
+
+          if (constrain)
+            {
+              gdouble candidate_shown = displayed_scale (candidate, width, height);
+              gdouble best_shown = displayed_scale (best, width, height);
+
+              /* A hundredth of the picture is below what anyone sees, so
+               * modes that close are treated as equal and the ordering
+               * below decides. */
+              if (ABS (candidate_shown - best_shown) > 0.01)
+                {
+                  if (candidate_shown > best_shown)
+                    best = candidate;
+                  continue;
+                }
+            }
+
+          if (compare_resolutions (best, candidate) < 0)
+            best = candidate;
+        }
+
+      if (best || !constrain)
+        break;
+
+      /* Nothing fitted inside the source; take the best of the rest. */
+      constrain = FALSE;
+    }
+
+  return best;
+}
+
