   g_object_get (sink, "state", &state, NULL);
   g_debug ("NdStream: State changed to %s",
            g_enum_to_string (ND_TYPE_SINK_STATE, state));
+  nd_stream_publish_state (self, state);
 
   switch (state)
     {
@@ -702,12 +726,35 @@
   g_source_attach (self->sigint_source, NULL);
 }
 
+/* Started for a unit, the helper is named after the connection part of the
+ * unit name, gnome-network-displays-stream-<sink>-<connection>.service, so
+ * that whoever started it can find it. Otherwise the name is random, as
+ * before. */
+gchar *
+nd_stream_application_id (const gchar *unit_name)
+{
+  g_autofree gchar *uuid = NULL;
+  const gchar *suffix = ".service";
+  gsize length;
+
+  if (unit_name && g_str_has_suffix (unit_name, suffix) &&
+      (length = strlen (unit_name) - strlen (suffix)) > 36)
+    {
+      uuid = g_strndup (unit_name + length - 36, 36);
+      if (g_uuid_string_is_valid (uuid))
+        return g_strdup_printf (ND_BUS_PREFIX ".Stream_%s", g_strdelimit (uuid, "-", '_'));
+    }
+
+  g_free (uuid);
+  uuid = g_uuid_string_random ();
+  return g_strdup_printf (ND_BUS_PREFIX ".Stream_%.8s", uuid);
+}
