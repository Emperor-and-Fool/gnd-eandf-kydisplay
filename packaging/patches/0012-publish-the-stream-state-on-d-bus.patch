+/* The sink's state is published as the state of the "state" action, which
+ * GApplication exports on D-Bus through org.gtk.Actions. A client can read it
+ * with Describe ("state") and so tell a stream that is still negotiating
+ * from one that is delivering a picture, whatever the protocol. */
+static void
+nd_stream_publish_state (NdStream *self, NdSinkState state)
+{
+  g_autoptr(GEnumClass) klass = g_type_class_ref (ND_TYPE_SINK_STATE);
+  GEnumValue *value = g_enum_get_value (klass, state);
+
+  if (self->state_action && value)
+    g_simple_action_set_state (self->state_action, g_variant_new_string (value->value_nick));
+}
+
