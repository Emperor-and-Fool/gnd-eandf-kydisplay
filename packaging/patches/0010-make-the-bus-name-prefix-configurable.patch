From: Mirdispo contributors
Subject: Make the D-Bus name prefix a build option

The daemon owns org.gnome.NetworkDisplays.Manager and registers as
org.gnome.NetworkDisplays.Daemon, and every stream helper registers as
org.gnome.NetworkDisplays.Stream_<id>. A program that ships this engine under
its own name then competes for those names with GNOME Network Displays on the
same desktop. Inside a Flatpak sandbox it also needs an exception to own names
outside its application ID.

The new bus_prefix option sets the prefix for all of these, and for the
PulseAudio application ID. It defaults to org.gnome.NetworkDisplays, so a
build that does not set it behaves as before. Object paths and interface
names are unchanged.

diff -ruN a/meson.build b/meson.build
--- a/meson.build
+++ b/meson.build
@@ -27,6 +27,7 @@
 add_project_arguments([
   '-I' + meson.current_build_dir(),
   '-DG_LOG_DOMAIN="Gnd"',
+  '-DND_BUS_PREFIX="@0@"'.format(get_option('bus_prefix')),
 ], language: 'c')
 
 enable_firewalld_zone = get_option('firewalld_zone')
diff -ruN a/meson_options.txt b/meson_options.txt
--- a/meson_options.txt
+++ b/meson_options.txt
@@ -13,6 +13,11 @@
        value: true,
        description: 'Build a graphical client app')
 
+option('bus_prefix',
+       type: 'string',
+       value: 'org.gnome.NetworkDisplays',
+       description: 'D-Bus name prefix the daemon and stream helper register under')
+
 option('systemd_resolved',
        type: 'boolean',
        value: false,
diff -ruN a/src/daemon/main.c b/src/daemon/main.c
--- a/src/daemon/main.c
+++ b/src/daemon/main.c
@@ -49,7 +49,7 @@
   gst_init (&argc, &argv);
 
   daemon = g_object_new (ND_TYPE_DAEMON,
-                         "application-id", "org.gnome.NetworkDisplays.Daemon",
+                         "application-id", ND_BUS_PREFIX ".Daemon",
                          "flags", G_APPLICATION_IS_SERVICE,
                          NULL);
 
diff -ruN a/src/nd-manager.c b/src/nd-manager.c
--- a/src/nd-manager.c
+++ b/src/nd-manager.c
@@ -478,7 +478,7 @@
 {
   manager->manager_name_watch_id =
     g_bus_own_name (G_BUS_TYPE_SESSION,
-                    "org.gnome.NetworkDisplays.Manager",
+                    ND_BUS_PREFIX ".Manager",
                     G_BUS_NAME_OWNER_FLAGS_NONE,
                     on_manager_bus_acquired,
                     on_manager_name_acquired,
diff -ruN a/src/nd-pulseaudio.c b/src/nd-pulseaudio.c
--- a/src/nd-pulseaudio.c
+++ b/src/nd-pulseaudio.c
@@ -366,7 +366,7 @@
 
   proplist = pa_proplist_new ();
   g_autofree gchar *app_name = g_strdup_printf ("GNOME Network Displays PulseAudio Client for %s", self->name);
-  g_autofree gchar *app_id = g_strdup_printf ("org.gnome.NetworkDisplays.PulseAudio_%.8s", self->uuid);
+  g_autofree gchar *app_id = g_strdup_printf (ND_BUS_PREFIX ".PulseAudio_%.8s", self->uuid);
   pa_proplist_sets (proplist, PA_PROP_APPLICATION_NAME, app_name);
   pa_proplist_sets (proplist, PA_PROP_APPLICATION_ID, app_id);
   /* pa_proplist_sets (proplist, PA_PROP_APPLICATION_ICON_NAME, ); */
diff -ruN a/src/stream/nd-stream.c b/src/stream/nd-stream.c
--- a/src/stream/nd-stream.c
+++ b/src/stream/nd-stream.c
@@ -692,7 +692,7 @@
 {
   NdStream *stream;
   g_autofree gchar *uuid = g_uuid_string_random ();
-  g_autofree gchar *id = g_strdup_printf ("org.gnome.NetworkDisplays.Stream_%.8s", uuid);
+  g_autofree gchar *id = g_strdup_printf (ND_BUS_PREFIX ".Stream_%.8s", uuid);
 
   g_debug ("NdStream: Starting with app-id: %s", id);
   stream = g_object_new (ND_TYPE_STREAM,
