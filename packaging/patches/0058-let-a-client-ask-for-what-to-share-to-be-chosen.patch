From: Mirdispo contributors
Subject: Let a client ask for what to share to be chosen

The helper can be told to leave the remembered choice alone so the desktop
asks instead, but only whatever starts it can tell it, and that is the
daemon. Nothing a client said could reach there: starting a cast names a
receiver and nothing else.

Starting one now also says whether to ask. It travels as what it is - an
argument on the method, read as a boolean - rather than being hidden in the
address, which the client never supplies anyway: the daemon builds that
itself from the receiver it looked up, so anything written there by a client
would be discarded before it was read.

From the daemon it goes into the environment the helper is started with,
beside the name the helper already reads from there, because the helper makes
its session while it is being constructed - before it has been handed the
address it was started for. Both ways of starting a helper carry it, the
transient unit and the child process a sandbox needs.

The method gains an argument rather than a sibling, so there is one way to
start a cast rather than two that drift apart. Clients must pass it, and
passing false is what they did before.

diff -ruN a/src/nd-manager.c b/src/nd-manager.c
--- a/src/nd-manager.c
+++ b/src/nd-manager.c
@@ -130,6 +130,7 @@
 
 static gchar *
 nd_manager_start_transient_unit (NdManager   *manager,
+                                 gboolean     choose_source,
                                  const gchar *uri,
                                  const gchar *uuid,
                                  const gchar *display_name)
@@ -143,7 +144,7 @@
   GVariant *properties;
   GVariant *aux;
 
-  properties = build_properties (unit_name, uri, display_name);
+  properties = build_properties (unit_name, uri, display_name, choose_source);
   aux = build_aux ();
 
   nd_dbus_org_freedesktop_systemd1_manager_call_start_transient_unit_sync (
@@ -189,7 +190,8 @@
 static gchar *
 nd_manager_start_sandboxed_stream (NdManager   *manager,
                                    const gchar *uri,
-                                   const gchar *uuid)
+                                   const gchar *uuid,
+                                   gboolean     choose_source)
 {
   g_autofree gchar *unit_name = build_stream_unit_name (uuid);
   g_autoptr(GSubprocessLauncher) launcher = NULL;
@@ -198,6 +200,8 @@
 
   launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_NONE);
   g_subprocess_launcher_setenv (launcher, "ND_STREAM_UNIT", unit_name, TRUE);
+  if (choose_source)
+    g_subprocess_launcher_setenv (launcher, "ND_STREAM_PICK", "new", TRUE);
   subprocess = g_subprocess_launcher_spawn (launcher, &error,
                                             nd_stream_helper_path (), uri, NULL);
   if (!subprocess)
@@ -255,6 +259,7 @@
 handle_start_stream_cb (NdDBusManager         *dbus_manager,
                         GDBusMethodInvocation *invocation,
                         const gchar           *uuid,
+                        gboolean               choose_source,
                         gpointer               user_data)
 {
   g_autoptr(GList) list = NULL;
@@ -291,9 +296,9 @@
   g_autofree gchar *name = NULL;
   g_object_get (sink, "display_name", &name, NULL);
   if (manager->sandboxed)
-    unit_name = nd_manager_start_sandboxed_stream (manager, uri, uuid);
+    unit_name = nd_manager_start_sandboxed_stream (manager, uri, uuid, choose_source);
   else
-    unit_name = nd_manager_start_transient_unit (manager, uri, uuid, name);
+    unit_name = nd_manager_start_transient_unit (manager, choose_source, uri, uuid, name);
 
   if (!unit_name)
     {
diff -ruN a/src/nd-systemd-helpers.c b/src/nd-systemd-helpers.c
--- a/src/nd-systemd-helpers.c
+++ b/src/nd-systemd-helpers.c
@@ -84,7 +84,8 @@
 GVariant *
 build_properties (const gchar *unit_name,
                   const gchar *uri,
-                  const gchar *display_name)
+                  const gchar *display_name,
+                  gboolean     choose_source)
 {
   GVariantBuilder properties_builder;
   GVariantBuilder environment_builder;
@@ -103,6 +104,14 @@
   g_variant_builder_init (&environment_builder, G_VARIANT_TYPE ("as"));
   g_variant_builder_add_value (&environment_builder,
                                g_variant_new_take_string (g_strdup_printf ("ND_STREAM_UNIT=%s", unit_name)));
+  /* Asking what to share rather than sharing what was shared last time has
+   * to be known before the helper has made a session, which happens while it
+   * is being constructed, before it has been handed the address it was
+   * started for. The environment is read then; the address is not. */
+  if (choose_source)
+    g_variant_builder_add_value (&environment_builder,
+                                 g_variant_new_string ("ND_STREAM_PICK=new"));
+
   g_variant_builder_add (&properties_builder, "(sv)", "Environment",
                          g_variant_builder_end (&environment_builder));
 
diff -ruN a/src/nd-systemd-helpers.h b/src/nd-systemd-helpers.h
--- a/src/nd-systemd-helpers.h
+++ b/src/nd-systemd-helpers.h
@@ -3,7 +3,8 @@
 
 GVariant * build_properties (const gchar *unit_name,
                              const gchar *uri,
-                             const gchar *display_name);
+                             const gchar *display_name,
+                             gboolean     choose_source);
 GVariant * build_aux ();
 gchar * build_stream_unit_name (const gchar *sink_uuid);
 const gchar * nd_stream_helper_path (void);
diff -ruN a/src/org.gnome.NetworkDisplays.Manager.xml b/src/org.gnome.NetworkDisplays.Manager.xml
--- a/src/org.gnome.NetworkDisplays.Manager.xml
+++ b/src/org.gnome.NetworkDisplays.Manager.xml
@@ -60,10 +60,15 @@
         @short_description: Connect and start streaming to a sink
 
         @sink_uuid: UUID of the sink to connect with
+        @choose_source: Ask what to share rather than share what was shared
+            last time. A desktop that remembers the answer is handed it back
+            on every cast, which is wanted until it is not; this says so for
+            one cast, and whatever is chosen becomes what is remembered next.
         @stream_unit_name: Name of the resulting transient service
     -->
     <method name="StartStream">
       <arg name="sink_uuid" type="s" direction="in" />
+      <arg name="choose_source" type="b" direction="in" />
       <arg name="stream_unit_name" type="s" direction="out" />
     </method>
 
