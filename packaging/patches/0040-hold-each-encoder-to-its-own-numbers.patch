diff -ruN a/src/wfd/wfd-media-factory.h b/src/wfd/wfd-media-factory.h
--- a/src/wfd/wfd-media-factory.h
+++ b/src/wfd/wfd-media-factory.h
@@ -105,6 +105,45 @@
 //{PROFILE_AUDIO_AAC,    ELEMENT_VIDEO_NONE, ELEMENT_AAC_FAAC,   ELEMENT_MPEGTS},
 };
 
+/* What each encoder is held to.
+ *
+ * A figure found by watching one encoder says nothing about the next. They
+ * answer to different rate controls, reach a given picture at different
+ * costs, and fail in different ways when asked for more than they can give.
+ * A rate that one of them holds steadily is one another overshoots in
+ * bursts, and a buffer that lets one borrow enough for a hard frame is
+ * either cramped or wasteful for another. Holding them all to one set of
+ * numbers means the numbers suit at most one of them, and silently suit
+ * nothing at all on a machine that uses a different one.
+ *
+ * So each is given its own, and is tuned by changing its own line.
+ *
+ * bitrate_kbit: what the picture is held to, or 0 to allow whatever the
+ *               receiver announced it can take.
+ * vbv_frames:   the buffer the rate control answers to, counted in frames
+ *               rather than in time, since that is what it comes to.
+ */
+typedef struct
+{
+  guint bitrate_kbit;
+  guint vbv_frames;
+} WfdEncoderTuning;
+
+static const WfdEncoderTuning wfd_encoder_tuning[ELEMENT_NONE + 1] = {
+  /* Found by watching this encoder on a link that was breaking up: the rate
+   * it kept and the buffer that let a hard frame through without bursting. */
+  [ELEMENT_X264]      = { .bitrate_kbit = 5 * 1024, .vbv_frames = 2 },
+
+  /* Not yet found. Started where the software encoder ended so that the two
+   * can be compared, and meant to be moved from here on what is seen. */
+  [ELEMENT_NVH264]    = { .bitrate_kbit = 5 * 1024, .vbv_frames = 2 },
+
+  /* Never measured. Left to the receiver's own maximum, as before. */
+  [ELEMENT_OPENH264]  = { .bitrate_kbit = 0, .vbv_frames = 0 },
+  [ELEMENT_VAH264]    = { .bitrate_kbit = 0, .vbv_frames = 0 },
+  [ELEMENT_VAAPIH264] = { .bitrate_kbit = 0, .vbv_frames = 0 },
+};
+
 typedef enum {
   WFD_QUIRK_NO_IDR = 0x01,
   WFD_QUIRK_NO_KEEPALIVE = 0x02,
