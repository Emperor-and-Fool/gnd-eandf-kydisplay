From: Mirdispo contributors
Subject: Fix a daemon use-after-free and an unbounded Chromecast teardown

Two crashes seen while casting to a receiver that is discovered over
several protocols at once:

 1. nd-meta-provider.c merged two meta sinks when a newly discovered sink
    matched both of them. The provider's sink array owns the only reference
    and frees its entries on removal, so removing the merged meta sink freed
    it; the code then emitted "sink-removed" with the freed pointer and
    walked its sink list. The daemon segfaulted inside the signal emission,
    which took discovery down with it and made receivers disappear from the
    list. The same function also announced "sink-added" with NULL instead of
    the sink the signal is documented to carry.

 2. cc-ctrl.c set the error state after invoking the end_stream callback,
    not before. Tearing the stream down sends a disconnect message, and when
    that write fails on an invalidated TLS session it lands back in
    cc_ctrl_close_connection(). The "avoid multiple calls" guard therefore
    never took effect and the recursion overflowed the stack, killing the
    stream process instead of reporting the error. nd-cc-sink.c had the same
    ordering problem in its own re-entrancy guard.

--- a/src/nd-meta-provider.c
+++ b/src/nd-meta-provider.c
@@ -79,6 +79,12 @@
           NdSink *merge_sink;
           merge_meta = g_ptr_array_remove_index_fast (meta_sinks, 0);
           g_debug ("NdMetaProvider: Removing previous meta sink from internal list");
+
+          /* meta_provider->sinks owns the only reference to the meta sink, and
+           * it is freed on removal. Hold a reference of our own, or the signal
+           * emission and the merge loop below operate on freed memory. */
+          g_object_ref (merge_meta);
+
           if (!g_ptr_array_remove (meta_provider->sinks, merge_meta))
             g_warning ("NdMetaProvider: Could not remove previous meta sink from internal list!");
           g_signal_emit_by_name (meta_provider, "sink-removed", merge_meta);
@@ -88,12 +94,15 @@
               nd_meta_sink_remove_sink (merge_meta, merge_sink);
               nd_meta_sink_add_sink (meta_sink, merge_sink);
             }
+
+          g_object_unref (merge_meta);
         }
 
       g_debug ("NdMetaProvider: Adding sink to meta sink");
       nd_meta_sink_add_sink (meta_sink, sink);
-      /* update the meta sink list */
-      g_signal_emit_by_name (meta_provider, "sink-added", NULL);
+      /* Update the meta sink list. The signal is documented to carry the sink
+       * that was added, so pass the meta sink rather than NULL. */
+      g_signal_emit_by_name (meta_provider, "sink-added", meta_sink);
 
       return;
     }

--- a/src/cc/cc-ctrl.c
+++ b/src/cc/cc-ctrl.c
@@ -542,8 +542,13 @@
   if (ctrl->state == CC_CTRL_STATE_ERROR)
     return;
 
-  ctrl->closure->end_stream (ctrl->closure->userdata, error);
+  /* The state has to be set before the callback runs. Tearing the stream down
+   * sends a disconnect message, and if that write fails it lands back here.
+   * Setting the state afterwards made that recursion unbounded, which
+   * overflowed the stack instead of reporting the error. */
   ctrl->state = CC_CTRL_STATE_ERROR;
+
+  ctrl->closure->end_stream (ctrl->closure->userdata, error);
 }
 
 void

--- a/src/nd-cc-sink.c
+++ b/src/nd-cc-sink.c
@@ -262,9 +262,12 @@
   if (self->state == ND_SINK_STATE_DISCONNECTED)
     return;
 
+  /* Set the state first: the teardown below can re-enter this function
+   * through the control channel's error path. */
+  self->state = ND_SINK_STATE_DISCONNECTED;
+
   nd_cc_sink_sink_stop_stream_int (self);
 
-  self->state = ND_SINK_STATE_DISCONNECTED;
   g_object_notify (G_OBJECT (self), "state");
 }
 

