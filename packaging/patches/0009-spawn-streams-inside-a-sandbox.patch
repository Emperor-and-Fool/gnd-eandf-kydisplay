 }
 
+static void
+sandboxed_stream_exited_cb (GObject      *source,
+                            GAsyncResult *result,
+                            gpointer      user_data)
+{
+  g_autoptr(NdManager) manager = user_data;
+  g_autoptr(GSubprocess) subprocess = g_object_ref (G_SUBPROCESS (source));
+  const gchar *unit_name;
+
+  g_subprocess_wait_finish (subprocess, result, NULL);
+
+  unit_name = g_object_get_data (G_OBJECT (subprocess), "nd-unit-name");
+  if (manager->sandboxed_streams &&
+      g_hash_table_lookup (manager->sandboxed_streams, unit_name) == subprocess)
+    g_hash_table_remove (manager->sandboxed_streams, unit_name);
+}
+
+/* The unit name is still what StartStream returns and StopStream takes, and
+ * the child gets it as ND_STREAM_UNIT, so a client can tell whether that
+ * stream is still running without asking systemd. */
+static gchar *
+nd_manager_start_sandboxed_stream (NdManager   *manager,
+                                   const gchar *uri,
+                                   const gchar *uuid)
+{
+  g_autofree gchar *unit_name = build_stream_unit_name (uuid);
+  g_autoptr(GSubprocessLauncher) launcher = NULL;
+  g_autoptr(GError) error = NULL;
+  GSubprocess *subprocess;
+
+  launcher = g_subprocess_launcher_new (G_SUBPROCESS_FLAGS_NONE);
+  g_subprocess_launcher_setenv (launcher, "ND_STREAM_UNIT", unit_name, TRUE);
+  subprocess = g_subprocess_launcher_spawn (launcher, &error,
+                                            nd_stream_helper_path (), uri, NULL);
+  if (!subprocess)
+    {
+      g_warning ("NdManager: Unable to spawn nd-stream: %s", error->message);
+      return NULL;
+    }
+
+  g_object_set_data_full (G_OBJECT (subprocess), "nd-unit-name",
+                          g_strdup (unit_name), g_free);
+  g_hash_table_insert (manager->sandboxed_streams, g_strdup (unit_name), subprocess);
+  g_subprocess_wait_async (subprocess, NULL, sandboxed_stream_exited_cb,
+                           g_object_ref (manager));
+
+  return g_steal_pointer (&unit_name);
+}
+
